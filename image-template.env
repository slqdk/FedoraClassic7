# Here we set a bunch of parameters for your image build

# output image name, keep it the same as the GitHub repo name
IMAGE_NAME=fedoraclassic7

# Your GitHub username. The GitHub workflows fill this in automatically;
# it only matters for local `just build` runs.
REPO_ORGANIZATION="slqdk"

IMAGE_DESC="Classic 7: Bazzite with a Windows Standard (Win7 Classic) look"
IMAGE_KEYWORDS="bootc,oci,linux,bazzite,kde,classic,gaming"

# Put your own image here for a fancy profile on https://artifacthub.io/!
IMAGE_LOGO_URL="https://avatars.githubusercontent.com/u/120078124?s=200&v=4"
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
