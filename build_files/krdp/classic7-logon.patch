         }
     }
 
     const auto users = d->server->users();
     for (auto user : users) {
         if (user.password.isEmpty()) {
-            return false;
+            continue; // Classic 7: one account without a password no longer locks out the others
         }
         if (user.name == username && user.password == password) {
             qCDebug(KRDP) << "User" << username << "authenticated successfully";
@@ -555,6 +608,9 @@ bool RdpConnection::onPostConnect()
         }
     }
 
