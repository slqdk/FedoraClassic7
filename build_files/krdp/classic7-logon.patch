+        const KUser self;
+        const QString plain = username.section(QLatin1Char('\\'), -1).section(QLatin1Char('@'), 0, 0).trimmed();
+        const QString fullName = self.property(KUser::FullName).toString().trimmed();
+        const auto isSelf = [&self, &fullName](const QString &name) {
+            return name.compare(self.loginName(), Qt::CaseInsensitive) == 0
+                || (!fullName.isEmpty() && name.compare(fullName, Qt::CaseInsensitive) == 0);
+        };
+        // the name as typed counts too (an account called "name@domain")
+        if (isSelf(plain) || isSelf(username.trimmed())) {
