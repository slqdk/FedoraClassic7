+// Classic 7: the client's address, for PAM
+static QString peerAddress(qintptr socketHandle)
+{
+    sockaddr_storage address = {};
+    socklen_t length = sizeof(address);
+    if (getpeername(int(socketHandle), reinterpret_cast<sockaddr *>(&address), &length) != 0) {
+        return QString();
+    }
+    return QHostAddress(reinterpret_cast<const sockaddr *>(&address)).toString();
+}
