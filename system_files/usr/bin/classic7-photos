#!/usr/bin/python3
"""Photo Viewer: look at pictures one at a time, in the style of Windows 7.

    classic7-photos [PICTURE | FOLDER]     open a picture (the others in its folder are a click away)
    classic7-photos --slideshow PICTURE    start a slide show of the folder
"""
import os
import sys

sys.path.insert(0, os.environ.get("CLASSIC7_LIB", "/usr/lib/classic7"))

if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        print(__doc__.strip())
        sys.exit(0)
    from photos_app import main
    sys.exit(main(sys.argv[1:]))
