#!/usr/bin/python3
"""Jump lists for the Start menu: recent documents and tasks of a program, like Windows 7.

    classic7-jumplist --json          every program's jump list as JSON (the Start menu reads this)
    classic7-jumplist --open APP N    open recent document N of APP
    classic7-jumplist --task APP N    run task N of APP

APP is the program's .desktop name without ".desktop", in lower case (classic7-write).
"""
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")

# program -> (QSettings file with a "recent" list, the command that opens a document)
RECENT = {
    "classic7-write": (CONFIG / "Classic7" / "Write.conf", ["classic7-write"]),
    "classic7-show": (CONFIG / "Classic7" / "Show.conf", ["classic7-show"]),
}

STEAM = [("Library", ["steam", "steam://open/games"]), ("Store", ["steam", "steam://store"]),
         ("Friends", ["steam", "steam://open/friends"]), ("Downloads", ["steam", "steam://open/downloads"]),
         ("Settings", ["steam", "steam://open/settings"])]
FIREFOX = [("Open new window", ["firefox", "--new-window"]),
           ("Open new private window", ["firefox", "--private-window"])]
TASKS = {
    "classic7-mail": [("New e-mail message", ["classic7-mail", "--compose"])],
    "classic7-write": [("New document", ["classic7-write"])],
    "classic7-show": [("New presentation", ["classic7-show"])],
    "steam": STEAM,
    "com.valvesoftware.steam": STEAM,
    "firefox": FIREFOX,
    "org.mozilla.firefox": FIREFOX,
    "classic7-prompt": [("New window", ["classic7-prompt"])],
    "classic7-computer": [("Disk Management", ["classic7-diskmgmt"]), ("Map network drive", ["classic7-netdrive"])],
    "org.kde.dolphin": [("New window", ["dolphin", "--new-window"])],
}


def read_recent(conf: Path) -> list[str]:
    """The "recent" list QSettings writes in an INI file (comma separated, quoted if needed)."""
    try:
        text = conf.read_text(errors="replace")
    except OSError:
        return []
    value = None
    group = "General"
    for line in text.splitlines():
        s = line.strip()
        if s.startswith("["):
            group = s.strip("[]")
            continue
        if group == "General" and s.startswith("recent="):
            value = s[len("recent="):]
    if not value or value.startswith("@Invalid"):
        return []
    out, cur, quoted, i = [], "", False, 0
    while i < len(value):
        c = value[i]
        if c == '"':
            quoted = not quoted
        elif c == "\\" and i + 1 < len(value):
            i += 1
            cur += {"n": "\n", "t": "\t"}.get(value[i], value[i])
        elif c == "," and not quoted:
            out.append(cur.strip())
            cur = ""
        else:
            cur += c
        i += 1
    if cur.strip():
        out.append(cur.strip())
    return [p for p in out if p and os.path.exists(p)]


ICONS = {".docx": "x-office-document", ".doc": "x-office-document", ".rtf": "x-office-document",
         ".odt": "x-office-document", ".txt": "text-plain", ".pptx": "x-office-presentation",
         ".ppt": "x-office-presentation", ".ppsx": "x-office-presentation", ".pps": "x-office-presentation",
         ".odp": "x-office-presentation", ".potx": "x-office-presentation"}


def lists() -> dict:
    out = {}
    for app in set(RECENT) | set(TASKS):
        recent = []
        if app in RECENT:
            for p in read_recent(RECENT[app][0])[:10]:
                recent.append({"name": Path(p).name, "path": p,
                               "icon": ICONS.get(Path(p).suffix.lower(), "text-x-generic")})
        tasks = [{"name": n} for n, argv in TASKS.get(app, []) if shutil.which(argv[0])]
        if recent or tasks:
            out[app] = {"recent": recent, "tasks": tasks}
    return out


def run(argv: list[str]):
    subprocess.Popen(argv, start_new_session=True, stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    if argv[0] == "--json":
        print(json.dumps(lists()))
        return 0
    if argv[0] in ("--open", "--task") and len(argv) == 3 and argv[2].isdigit():
        app, n = argv[1].lower(), int(argv[2])
        if argv[0] == "--open" and app in RECENT:
            files = read_recent(RECENT[app][0])
            if n < len(files):
                run(RECENT[app][1] + [files[n]])
                return 0
        if argv[0] == "--task":
            tasks = [t for t in TASKS.get(app, []) if shutil.which(t[1][0])]
            if n < len(tasks):
                run(tasks[n][1])
                return 0
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
