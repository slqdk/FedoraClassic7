#!/usr/bin/python3
"""Write: a word processor in the style of Word 2007.

    classic7-write [FILE...]     open .docx, .doc, .rtf, .txt or .html files
"""
import os
import sys

sys.path.insert(0, os.environ.get("CLASSIC7_LIB", "/usr/lib/classic7"))

if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        print(__doc__.strip())
        sys.exit(0)
    from write_app import main
    sys.exit(main(sys.argv[1:]))
