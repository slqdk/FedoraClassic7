#!/usr/bin/python3
"""Arrange the open windows like Windows 7's taskbar menu (used by the taskbar's right-click menu).

    classic7-arrange cascade      Cascade windows
    classic7-arrange stacked      Show windows stacked
    classic7-arrange side         Show windows side by side
"""
import os
import sys

sys.path.insert(0, os.environ.get("CLASSIC7_LIB", "/usr/lib/classic7"))

if __name__ == "__main__":
    mode = sys.argv[1] if len(sys.argv) > 1 else ""
    if mode not in ("cascade", "stacked", "side"):
        print(__doc__.strip())
        sys.exit(0 if mode in ("-h", "--help") else 2)
    from PySide6.QtCore import QCoreApplication, QTimer
    from kwin_bridge import KWinBridge
    app = QCoreApplication(sys.argv[:1])
    bridge = KWinBridge("Arrange")
    if not bridge.available():
        print("classic7-arrange: KWin is not reachable", file=sys.stderr)
        sys.exit(1)
    bridge.arrange(mode)
    QTimer.singleShot(1800, app.quit)       # the script is unloaded after 1.5 s
    sys.exit(app.exec())
