#!/usr/bin/python3
"""Run dialog (Win+R): open a program, folder, document or web site by typing its name.

    classic7-run           show the dialog
    classic7-run TEXT      run TEXT directly (same rules as the dialog)
"""
import os
import shlex
import shutil
import subprocess
import sys
from pathlib import Path

HISTORY = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "classic7" / "run-history"
MAX_HISTORY = 26

# Windows names people type out of habit
ALIASES = {
    "cmd": ["classic7-prompt"],
    "command": ["classic7-prompt"],
    "powershell": ["classic7-prompt"],
    "explorer": ["dolphin"],
    "control": ["systemsettings"],
    "control panel": ["systemsettings"],
    "taskmgr": ["plasma-systemmonitor"],
    "notepad": ["kwrite"],
    "calc": ["kcalc"],
    "mspaint": ["kolourpaint"],
    "regedit": ["systemsettings"],
    "msconfig": ["systemsettings"],
    "devmgmt.msc": ["systemsettings", "kcm_about-distro"],
    "computer": ["classic7-computer"],
    "appwiz.cpl": ["bazaar"],
    "ncpa.cpl": ["classic7-network"],
    "control netconnections": ["classic7-network"],
    "write": ["classic7-write"],
    "winword": ["classic7-write"],
    "wordpad": ["classic7-write"],
    "outlook": ["classic7-mail"],
    "photoviewer": ["classic7-photos"],
    "photoviewer.dll": ["classic7-photos"],
    "7zfm": ["ark"],
    "7-zip": ["ark"],
    "msimn": ["classic7-mail"],
    "winmail": ["classic7-mail"],
    "wab": ["classic7-mail"],
    "wuapp": ["classic7-update", "--gui"],
    "control update": ["classic7-update", "--gui"],
}


def load_history() -> list[str]:
    try:
        return [l for l in HISTORY.read_text().splitlines() if l.strip()][:MAX_HISTORY]
    except OSError:
        return []


def save_history(text: str):
    items = [text] + [h for h in load_history() if h != text]
    try:
        HISTORY.parent.mkdir(parents=True, exist_ok=True)
        HISTORY.write_text("\n".join(items[:MAX_HISTORY]) + "\n")
    except OSError:
        pass


def detached(argv: list[str]):
    subprocess.Popen(argv, start_new_session=True, stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def resolve(text: str):
    """Return (argv, error). Paths and URLs open with their program, names run."""
    text = text.strip()
    if not text:
        return None, ""
    low = text.lower()
    if low in ALIASES and shutil.which(ALIASES[low][0]):
        return ALIASES[low], None
    expanded = os.path.expandvars(os.path.expanduser(text))
    if "://" in text or text.startswith(("www.", "mailto:")):
        url = text if "://" in text or text.startswith("mailto:") else "https://" + text
        return ["xdg-open", url], None
    if expanded.startswith(("/", ".")) or os.path.exists(expanded):
        if os.path.exists(expanded):
            if os.path.isfile(expanded) and os.access(expanded, os.X_OK):
                return [expanded], None
            return ["xdg-open", expanded], None
        return None, f"Cannot find '{text}'. Make sure you typed the name correctly, and then try again."
    try:
        argv = shlex.split(expanded)
    except ValueError as e:
        return None, f"Cannot run '{text}': {e}"
    if shutil.which(argv[0]):
        return argv, None
    # a desktop file id, e.g. "steam" -> steam.desktop
    for d in (Path.home() / ".local/share/applications", Path("/var/lib/flatpak/exports/share/applications"),
              Path("/usr/share/applications")):
        for cand in d.glob(f"*{argv[0]}*.desktop") if d.is_dir() else []:
            return ["gtk-launch" if shutil.which("gtk-launch") else "kioclient", *(
                [cand.stem] if shutil.which("gtk-launch") else ["exec", str(cand)])], None
    return None, f"Cannot find '{text}'. Make sure you typed the name correctly, and then try again."


def run_text(text: str) -> str | None:
    argv, error = resolve(text)
    if error:
        return error
    if argv:
        try:
            detached(argv)
        except OSError as e:
            return f"Cannot run '{text}': {e.strerror}"
        save_history(text.strip())
    return None


def dialog() -> int:
    from PySide6.QtCore import Qt
    from PySide6.QtGui import QIcon
    from PySide6.QtWidgets import (QApplication, QComboBox, QDialog, QDialogButtonBox, QFileDialog, QGridLayout,
                                   QLabel, QMessageBox, QSizePolicy)

    app = QApplication(sys.argv[:1])
    app.setApplicationName("classic7-run")
    app.setDesktopFileName("classic7-run")

    dlg = QDialog()
    dlg.setWindowTitle("Run")
    dlg.setWindowIcon(QIcon.fromTheme("system-run"))
    grid = QGridLayout(dlg)

    icon = QLabel()
    icon.setPixmap(QIcon.fromTheme("system-run").pixmap(32, 32))
    icon.setAlignment(Qt.AlignTop)
    text = QLabel("Type the name of a program, folder, document, or Internet resource, "
                  "and it will be opened for you.")
    text.setWordWrap(True)
    grid.addWidget(icon, 0, 0)
    grid.addWidget(text, 0, 1, 1, 2)

    label = QLabel("&Open:")
    combo = QComboBox()
    combo.setEditable(True)
    combo.setInsertPolicy(QComboBox.NoInsert)
    combo.addItems(load_history())
    combo.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed)
    combo.lineEdit().selectAll()
    label.setBuddy(combo)
    grid.addWidget(label, 1, 0)
    grid.addWidget(combo, 1, 1, 1, 2)

    buttons = QDialogButtonBox(QDialogButtonBox.Ok | QDialogButtonBox.Cancel)
    browse = buttons.addButton("&Browse...", QDialogButtonBox.ActionRole)
    grid.addWidget(buttons, 2, 0, 1, 3)
    ok = buttons.button(QDialogButtonBox.Ok)
    ok.setEnabled(bool(combo.currentText().strip()))
    combo.editTextChanged.connect(lambda t: ok.setEnabled(bool(t.strip())))

    def accept():
        error = run_text(combo.currentText())
        if error:
            QMessageBox.critical(dlg, combo.currentText().strip(), error)
            combo.lineEdit().selectAll()
            combo.setFocus()
            return
        dlg.accept()

    def pick():
        path, _ = QFileDialog.getOpenFileName(dlg, "Browse", str(Path.home()))
        if path:
            combo.setEditText(path)

    buttons.accepted.connect(accept)
    buttons.rejected.connect(dlg.reject)
    browse.clicked.connect(pick)
    dlg.setFixedWidth(400)
    dlg.show()
    combo.setFocus()
    return 0 if dlg.exec() == QDialog.Accepted else 1


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        print(__doc__.strip())
        sys.exit(0)
    if len(sys.argv) > 1:
        err = run_text(" ".join(sys.argv[1:]))
        if err:
            print(err, file=sys.stderr)
            sys.exit(1)
        sys.exit(0)
    sys.exit(dialog())
