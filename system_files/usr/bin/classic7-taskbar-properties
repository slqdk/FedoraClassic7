#!/usr/bin/python3
"""Taskbar and Start Menu Properties, as in Windows 7.

    classic7-taskbar-properties                  open the dialog
    classic7-taskbar-properties --page PAGE      on a tab: taskbar, startmenu or toolbars
    classic7-taskbar-properties --tray           Notification Area Icons on its own
    classic7-taskbar-properties --show           print what the taskbar has now (JSON)
"""
import argparse
import json
import os
import sys
from dataclasses import asdict

sys.path.insert(0, os.environ.get("CLASSIC7_LIB", "/usr/lib/classic7"))

parser = argparse.ArgumentParser(description="Taskbar and Start Menu Properties")
parser.add_argument("--page", choices=["taskbar", "startmenu", "toolbars"], default="taskbar")
parser.add_argument("--show", action="store_true")
parser.add_argument("--tray", action="store_true")
args, rest = parser.parse_known_args()

if args.show:
    import taskbar_props as tp
    state = tp.read()
    print(json.dumps(asdict(state), indent=2))
    sys.exit(0 if state.found else 1)

if args.tray:
    from taskbar_props_app import tray_main
    sys.exit(tray_main([sys.argv[0]] + rest))

from taskbar_props_app import main  # noqa: E402
sys.exit(main([sys.argv[0]] + rest, page=args.page))
