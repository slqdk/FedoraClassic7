#!/usr/bin/python3
"""Programs and Features: uninstall or change a program (app store apps, Steam games,
packages added to the system).

    classic7-programs            the window
    classic7-programs --list     the installed programs as text
"""
import os
import sys

sys.path.insert(0, os.environ.get("CLASSIC7_LIB", "/usr/lib/classic7"))

if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        print(__doc__.strip())
        sys.exit(0)
    if len(sys.argv) > 1 and sys.argv[1] == "--list":
        import programs_data as pd
        for p in pd.all_programs():
            print(f"{p.kind:8} {p.name[:40]:40} {p.publisher[:24]:24} {pd.fmt_date(p.installed):10} "
                  f"{pd.fmt_size(p.size):>9}  {p.version}")
        sys.exit(0)
    from programs_app import main
    sys.exit(main())
