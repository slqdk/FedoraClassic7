#!/usr/bin/python3
"""Pin programs to the taskbar, like Windows' "Pin to Taskbar": the Quick Launch icons next to
Start (Classic), or the task buttons themselves (Aero and Basic: icons-only task manager).

    classic7-taskbar-pin PROGRAM            pin (a .desktop file, its path, URL or id)
    classic7-taskbar-pin --add PROGRAM      the same
    classic7-taskbar-pin --remove PROGRAM   unpin
    classic7-taskbar-pin --list             what is pinned (file URLs)
"""
import json
import os
import re
import subprocess
import sys
from pathlib import Path
from urllib.parse import quote, unquote

CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")
APPLETSRC = CONFIG / "plasma-org.kde.plasma.desktop-appletsrc"


def data_dirs() -> list[Path]:
    home = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share")
    dirs = [home] + [Path(d) for d in (os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":") if d]
    for extra in (home / "flatpak/exports/share", Path("/var/lib/flatpak/exports/share")):
        if extra not in dirs:
            dirs.append(extra)
    return dirs


def resolve(program: str) -> str:
    """-> file:// URL of the program's .desktop file."""
    p = program.strip()
    if p.startswith("file://"):
        p = unquote(p[7:])
    p = re.sub(r"^applications:", "", p)
    if os.path.isabs(p) or os.path.exists(p):
        # not resolve(): a Flatpak's exported file is a link into a folder its next update removes
        path = Path(os.path.abspath(p))
        if path.is_file():
            return "file://" + quote(str(path))
        raise SystemExit(f"classic7-taskbar-pin: {program} not found")
    name = p if p.endswith(".desktop") else p + ".desktop"
    for d in data_dirs():
        cand = d / "applications" / name
        if cand.is_file():
            return "file://" + quote(str(cand))
        # ids like kde-foo.desktop may live in applications/kde/foo.desktop
        if "-" in name:
            sub = d / "applications" / name.replace("-", "/", 1)
            if sub.is_file():
                return "file://" + quote(str(sub))
    raise SystemExit(f"classic7-taskbar-pin: no program called {program}")


TASK_MANAGERS = ("org.kde.plasma.icontasks", "org.kde.plasma.taskmanager")


def base_name(url: str) -> str:
    """foo.desktop for file:///.../foo.desktop, applications:foo.desktop or foo.desktop."""
    return Path(unquote(re.sub(r"^(applications:|file://)", "", url.strip()))).name


def pinned() -> list[str]:
    """What is pinned: Quick Launch's launcherUrls and the task manager's launchers, from the
    saved panel layout (as file:// URLs where the program can be found)."""
    try:
        text = APPLETSRC.read_text(errors="replace")
    except OSError:
        return []
    groups, cur = {}, None
    for line in text.splitlines():
        if line.startswith("["):
            cur = line.strip()
            groups.setdefault(cur, {})
        elif cur and "=" in line:
            k, v = line.split("=", 1)
            groups[cur][k] = v
    out = []
    for head, kv in groups.items():
        key = {"org.kde.plasma.quicklaunch": "launcherUrls"}.get(kv.get("plugin", ""))
        if not key and kv.get("plugin") in TASK_MANAGERS:
            key = "launchers"
        if not key:
            continue
        cfg = groups.get(head + "[Configuration][General]", {})
        for u in re.split(r"(?<!\\),", cfg.get(key, "")):
            u = u.replace("\\,", ",").strip()
            if u.startswith("applications:"):
                try:
                    u = resolve(u)
                except SystemExit:
                    pass
            if u and not any(base_name(u) == base_name(o) for o in out):
                out.append(u)
    return out


def change(url: str, add: bool) -> bool:
    # Pin: Quick Launch when the taskbar has it (Classic), else the task buttons' own launchers
    # (Aero and Basic; also text task buttons). Unpin: from all of them. False if nothing could.
    js = """
var url = %s, add = %s, done = false;
function base(u) { u = String(u).replace(/^applications:/, ""); return decodeURIComponent(u.split("/").pop()); }
function edit(w, key) {
    w.currentConfigGroup = ["General"];
    var l = w.readConfig(key, []);
    if (typeof l === "string") l = l ? l.split(",") : [];
    var name = base(url);
    var has = l.filter(function (u) { return base(u) === name; });
    if (add && has.length === 0) l.push(url);
    if (!add) l = l.filter(function (u) { return base(u) !== name; });
    w.writeConfig(key, l);
    w.reloadConfig();
    done = true;
}
[["org.kde.plasma.quicklaunch", "launcherUrls"], ["org.kde.plasma.icontasks", "launchers"],
 ["org.kde.plasma.taskmanager", "launchers"]].forEach(function (kind) {
    panels().forEach(function (p) {
        p.widgets(kind[0]).forEach(function (w) {
            if (done && add) return;
            edit(w, kind[1]);
        });
    });
});
print(done ? "C7PINNED" : "C7NOTASKBAR");
""" % (json.dumps(url), "true" if add else "false")
    try:
        r = subprocess.run(["dbus-send", "--session", "--dest=org.kde.plasmashell", "--type=method_call",
                            "--print-reply=literal", "/PlasmaShell", "org.kde.PlasmaShell.evaluateScript",
                            "string:" + js], capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        return False
    return r.returncode == 0 and "C7PINNED" in r.stdout


def main(argv) -> int:
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    if argv[0] == "--list":
        print("\n".join(pinned()))
        return 0
    add = True
    if argv[0] in ("--add", "--remove"):
        add = argv[0] == "--add"
        argv = argv[1:]
    ok = True
    for prog in argv:
        ok &= change(resolve(prog), add)
    if not ok:
        print("classic7-taskbar-pin: the taskbar could not be changed (is the desktop running?)", file=sys.stderr)
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
