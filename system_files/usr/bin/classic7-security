#!/usr/bin/python3
"""The Ctrl+Alt+Del screen: lock, switch user, log off, change your password or start
Task Manager, in the style of Windows 7.

    classic7-security       show the screen
"""
import os
import sys

sys.path.insert(0, os.environ.get("CLASSIC7_LIB", "/usr/lib/classic7"))

if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        print(__doc__.strip())
        sys.exit(0)
    from security_screen import main
    sys.exit(main(sys.argv[1:]))
