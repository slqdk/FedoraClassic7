[Unit]
Description=Classic 7: login fixes (one network icon, Explorer navigation pane)
# edit the saved panel layout before Plasma's desktop reads it
Before=plasma-plasmashell.service
PartOf=graphical-session.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/classic7-tray-fix

[Install]
WantedBy=plasma-core.target
