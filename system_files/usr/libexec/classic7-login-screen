#!/usr/bin/python3
"""Classic 7: the login screen (SDDM) gets the look and the screen settings of the desktop, as in
Windows, where the screen resolution and the theme reach the logon screen too. Run as root through
pkexec (org.classic7.loginscreen.policy) by the desktop: classic7-appearance --login-screen, after a
theme change, at login and when the screen settings change. Administrators sitting at the computer
need no password (50-classic7.rules).

    pkexec /usr/libexec/classic7-login-screen LOOK < kwinoutputconfig.json

LOOK is aero, basic or classic: Aero and Basic get the Windows 7 Welcome screen (theme
classic7aero), Classic the Log On dialog (classic7); "keep" leaves the theme. Standard input is the
desktop's KWin screen settings (~/.config/kwinoutputconfig.json: resolution, refresh rate, scale,
arrangement), which the login screen's KWin reads from SDDM's home; empty input leaves them. This is
what System Settings > Login Screen > "Apply Plasma Settings" does for the screen settings. A theme
chosen there (kde_settings.conf, read after this file) still wins."""
import json
import os
import pwd
import stat
import sys
import tempfile
from pathlib import Path

LOOK_FILE = Path("/etc/sddm.conf.d/classic7.look.conf")
THEMES = {"aero": ("classic7aero", "Breeze_Light"), "basic": ("classic7aero", "Breeze_Light"),
          "classic": ("classic7", "Chicago95_Standard_Cursors")}
MAX_SCREEN = 1 << 20


def write(path: Path, data: bytes, mode: int = 0o644):
    """Replace a root-owned file in one step (a new file renamed over it, never through a link)."""
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=".classic7-")
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
            os.fchmod(f.fileno(), mode)
        os.replace(tmp, path)
    except BaseException:
        Path(tmp).unlink(missing_ok=True)
        raise


def set_theme(look: str) -> str | None:
    theme, cursor = THEMES[look]
    if not Path("/usr/share/sddm/themes", theme, "Main.qml").is_file():
        return None
    lines = ["# Classic 7: the login screen follows the look chosen in Personalization",
             "# (written by /usr/libexec/classic7-login-screen; a theme chosen in System Settings wins)",
             "[Theme]", f"Current={theme}"]
    if Path("/usr/share/icons", cursor, "cursors").is_dir():
        lines.append(f"CursorTheme={cursor}")
    text = ("\n".join(lines) + "\n").encode()
    try:
        if LOOK_FILE.read_bytes() == text:
            return None
    except OSError:
        pass
    LOOK_FILE.parent.mkdir(parents=True, exist_ok=True)
    write(LOOK_FILE, text)
    return f"theme {theme}"


def _as_sddm(sddm: pwd.struct_passwd, data: bytes, cfg) -> bool:
    """In a child process that is the sddm account (no root left), so nothing sddm owns, such as a
    link put in place of a file, can make root write somewhere else. True when the file changed."""
    pid = os.fork()
    if pid == 0:
        code = 3
        try:
            os.setgroups([])
            os.setgid(sddm.pw_gid)
            os.setuid(sddm.pw_uid)
            home = Path(sddm.pw_dir or "/var/lib/sddm")
            conf = home / ".config"
            if conf.is_symlink():
                conf.unlink()
            conf.mkdir(mode=0o750, exist_ok=True)
            target = conf / "kwinoutputconfig.json"
            same = False
            try:
                fd = os.open(target, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
                with os.fdopen(fd, "rb") as f:
                    if stat.S_ISREG(os.fstat(f.fileno()).st_mode):
                        same = json.loads(f.read(MAX_SCREEN + 1)) == cfg
            except (OSError, ValueError):
                pass
            if same:
                code = 0
            else:
                fd, tmp = tempfile.mkstemp(dir=conf, prefix=".classic7-")
                with os.fdopen(fd, "wb") as f:
                    f.write(data)
                    os.fchmod(f.fileno(), 0o644)
                os.replace(tmp, target)
                code = 1
        except BaseException:  # noqa: BLE001 - the child only reports through its exit code
            code = 3
        os._exit(code)
    _pid, status = os.waitpid(pid, 0)
    code = os.waitstatus_to_exitcode(status)
    if code not in (0, 1):
        raise OSError("the screen settings couldn't be written to the login screen's settings")
    return code == 1


def set_screen(data: bytes) -> str | None:
    if len(data) > MAX_SCREEN:
        raise ValueError("the screen settings are too large")
    cfg = json.loads(data)
    if not isinstance(cfg, (list, dict)):
        raise ValueError("these are not KWin screen settings")
    try:
        sddm = pwd.getpwnam("sddm")
    except KeyError:
        raise ValueError("there is no sddm account (the login screen isn't SDDM)") from None
    return "screen settings" if _as_sddm(sddm, data, cfg) else None


def main() -> int:
    if len(sys.argv) != 2 or sys.argv[1] not in (*THEMES, "keep"):
        print(__doc__)
        return 2
    done = []
    try:
        if sys.argv[1] != "keep":
            note = set_theme(sys.argv[1])
            if note:
                done.append(note)
        data = b"" if sys.stdin.isatty() else sys.stdin.buffer.read(MAX_SCREEN + 1)
        if data.strip():
            note = set_screen(data)
            if note:
                done.append(note)
    except (OSError, ValueError) as e:
        print(f"classic7-login-screen: {e}", file=sys.stderr)
        return 1
    print("login screen: " + (", ".join(done) if done else "already up to date"))
    return 0


if __name__ == "__main__":
    sys.exit(main())
