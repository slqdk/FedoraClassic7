#!/usr/bin/python3
"""Classic 7 session helper: see /usr/lib/classic7/sessiond.py.

Takes KDE's file-operation progress service names (org.kde.kuiserver, org.kde.JobViewServer)
before anything slow is loaded, then org.classic7.Session, which tells systemd it has started, so
Plasma's desktop (ordered after this) finds the names taken."""
import os
import sys

import dbus
import dbus.service
from dbus.mainloop.glib import DBusGMainLoop

DBusGMainLoop(set_as_default=True)
bus = dbus.SessionBus()
names = []
for name in ("org.kde.JobViewServer", "org.kde.kuiserver"):
    try:
        names.append(dbus.service.BusName(name, bus, allow_replacement=False, replace_existing=False,
                                          do_not_queue=True))
    except dbus.exceptions.NameExistsException:
        print(f"classic7-sessiond: {name} is taken, so the desktop shows file operations itself", file=sys.stderr)
have_jobs = len(names) == 2
if not have_jobs:
    for n in names:                 # half a server would only confuse programs
        bus.release_name(n.get_name())
    names.clear()
ready = dbus.service.BusName("org.classic7.Session", bus, do_not_queue=True)

sys.path.insert(0, os.environ.get("CLASSIC7_LIB", "/usr/lib/classic7"))
from sessiond import main  # noqa: E402 - after the names are taken

sys.exit(main(bus, have_jobs))
