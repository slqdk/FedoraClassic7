#!/usr/bin/python3
"""Classic 7 login fixes, run before Plasma's desktop starts (classic7-tray-fix.service):

 1. One network icon in the system tray: edits the saved panel layout directly, removing
    Plasma's own network applet and keeping Classic 7's once. (Doing it while Plasma runs
    doesn't stick: Plasma writes its in-memory tray list back.)  Marker: tray-fixed
 2. Explorer's navigation pane without Recent / Search For / Tags. KDE creates the places
    file the first time a file window opens, so this is retried at each login until it
    exists.  Marker: places-fixed
 3. The taskbar's right-click menu like Windows 7 (Cascade windows... Start Task Manager): sets
    the panels' menu plugin to org.classic7.taskbarmenu. A panel reads it when Plasma starts,
    so this too is done before Plasma.  Marker: taskbar-menu
 4. The desktop's Recycle Bin opens Classic 7's Recycle Bin window: the icon from the first login
    (a KDE trash:/ link that opens Explorer) becomes the Recycle Bin program's icon, with "Empty
    Recycle Bin" on its menu and full / empty pictures.  Marker: recycle-bin-app
"""
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

NM, OURS = "org.kde.plasma.networkmanagement", "org.classic7.network"
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")
APPLETSRC = CONFIG / "plasma-org.kde.plasma.desktop-appletsrc"
MARKER = CONFIG / "classic7" / "tray-fixed-3"     # -3: Plasma 6.7 keeps the tray items inside the tray applet


def plasma_running() -> bool:
    return subprocess.run(["pgrep", "-u", str(os.getuid()), "-x", "plasmashell"],
                          capture_output=True).returncode == 0


def parse(text: str):
    """[(group header or None, [lines])] in file order."""
    sections, cur = [], (None, [])
    for line in text.splitlines():
        if line.startswith("[") and line.rstrip().endswith("]"):
            sections.append(cur)
            cur = (line.rstrip(), [])
        else:
            cur[1].append(line)
    sections.append(cur)
    return sections


def key(lines, name):
    for ln in lines:
        if ln.startswith(name + "="):
            return ln.split("=", 1)[1]
    return None


def set_key(lines, name, value):
    for i, ln in enumerate(lines):
        if ln.startswith(name + "="):
            lines[i] = f"{name}={value}"
            return
    # before trailing blank lines
    i = len(lines)
    while i > 0 and not lines[i - 1].strip():
        i -= 1
    lines.insert(i, f"{name}={value}")


def fix(text: str) -> tuple[str, bool]:
    sections = parse(text)
    # Where the tray's own items live:
    #  * Plasma 6.7+: inside the system tray applet, [Containments][2][Applets][7][Applets][17]
    #  * older: in a separate containment named by SystrayContainmentId, [Containments][8][Applets][20]
    prefixes = []
    for head, lines in sections:
        if head and key(lines, "plugin") == "org.kde.plasma.systemtray":
            prefixes.append(head[:-1] + "][Applets][")
        tray_id = key(lines, "SystrayContainmentId")
        if tray_id:
            prefixes.append(f"[Containments][{tray_id}][Applets][")
    if not prefixes:
        return text, False
    remove: set[str] = set()          # "[Containments][2][Applets][7][Applets][17]" headers
    for prefix in prefixes:
        ours_seen = False
        for head, lines in sections:
            if not head or not head.startswith(prefix) or not re.fullmatch(r"\d+\]", head[len(prefix):]):
                continue
            plugin = key(lines, "plugin")
            if plugin == NM or (plugin == OURS and ours_seen):
                remove.add(head)
            elif plugin == OURS:
                ours_seen = True
    changed = bool(remove)
    out = []
    for head, lines in sections:
        if head and any(head == r or head.startswith(r[:-1] + "][") for r in remove):
            continue
        # the tray's entry lists: in Plasma 6 they are in the system tray applet's own
        # [Containments][panel][Applets][tray][General] group (older: the inner containment's)
        if head and key(lines, "extraItems") is not None:
            extra = [x for x in (key(lines, "extraItems") or "").split(",") if x and x != NM]
            if OURS not in extra:
                extra.append(OURS)
            known = [x for x in (key(lines, "knownItems") or "").split(",") if x]
            for x in (NM, OURS):
                if x not in known:
                    known.append(x)
            new_extra, new_known = ",".join(extra), ",".join(known)
            if key(lines, "extraItems") != new_extra or key(lines, "knownItems") != new_known:
                set_key(lines, "extraItems", new_extra)
                set_key(lines, "knownItems", new_known)
                changed = True
        out.append((head, lines))
    if not changed:
        return text, False
    body = []
    for head, lines in out:
        if head:
            body.append(head)
        body += lines
    return "\n".join(body).rstrip("\n") + "\n", True


def places_fix():
    marker = CONFIG / "classic7" / "places-fixed"
    if marker.exists() or subprocess.run(["pgrep", "-u", str(os.getuid()), "-x", "dolphin"],
                                         capture_output=True).returncode == 0:
        return
    sys.path.insert(0, os.environ.get("CLASSIC7_LIB", "/usr/lib/classic7"))
    try:
        import classic7appearance
        if classic7appearance.hide_place_groups():
            marker.parent.mkdir(parents=True, exist_ok=True)
            marker.write_text("1\n")
    except Exception as e:   # noqa: BLE001
        print(f"classic7-tray-fix: places: {e}")


MENU_PLUGIN = "org.classic7.taskbarmenu"
MENU_SO = Path("/usr/lib64/qt6/plugins/plasma/containmentactions") / f"{MENU_PLUGIN}.so"
MENU_MARKER = CONFIG / "classic7" / "taskbar-menu"


def menu_fix(text: str) -> tuple[str, bool]:
    """[ActionPlugins][1] (1 = panels): RightButton;NoModifier=org.classic7.taskbarmenu."""
    sections = parse(text)
    for head, lines in sections:
        if head == "[ActionPlugins][1]":
            if key(lines, "RightButton;NoModifier") == MENU_PLUGIN:
                return text, False
            set_key(lines, "RightButton;NoModifier", MENU_PLUGIN)
            break
    else:
        if sections and sections[-1][1] and sections[-1][1][-1].strip():
            sections[-1][1].append("")
        sections.append(("[ActionPlugins][1]", [f"RightButton;NoModifier={MENU_PLUGIN}", ""]))
    body = []
    for head, lines in sections:
        if head:
            body.append(head)
        body += lines
    return "\n".join(body).rstrip("\n") + "\n", True


RECYCLE_MARKER = CONFIG / "classic7" / "recycle-bin-app"
RECYCLE_NEW = Path("/usr/share/classic7/desktop/recycle-bin.desktop")


def desktop_dir() -> Path:
    try:
        out = subprocess.run(["xdg-user-dir", "DESKTOP"], capture_output=True, text=True, timeout=3).stdout.strip()
        if out and Path(out) != Path.home():
            return Path(out)
    except (OSError, subprocess.SubprocessError):
        pass
    return Path.home() / "Desktop"


def trash_empty() -> bool:
    info = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share") / "Trash" / "info"
    try:
        return not any(info.iterdir())
    except OSError:
        return True


def recycle_fix(force: bool):
    if (RECYCLE_MARKER.exists() and not force) or not RECYCLE_NEW.exists():
        return
    old = desktop_dir() / "recycle-bin.desktop"
    try:
        text = old.read_text(errors="replace")
    except OSError:
        text = ""
    if text and "Type=Link" in text and "URL=trash:/" in text:
        name = next((ln.split("=", 1)[1] for ln in text.splitlines() if ln.startswith("Name=")), "Recycle Bin")
        new = RECYCLE_NEW.read_text()
        new = new.replace("Name=Recycle Bin\n", f"Name={name}\n", 1)
        new = new.replace("Icon=user-trash\n", "Icon=user-trash\n" if trash_empty() else "Icon=user-trash-full\n", 1)
        tmp = old.with_name(".recycle-bin.desktop.tmp")
        tmp.write_text(new)
        os.chmod(tmp, 0o755)
        tmp.replace(old)
        print("classic7-tray-fix: the desktop's Recycle Bin now opens the Recycle Bin window")
    RECYCLE_MARKER.parent.mkdir(parents=True, exist_ok=True)
    RECYCLE_MARKER.write_text("1\n")


def main() -> int:
    force = "--force" in sys.argv
    places_fix()
    try:
        recycle_fix(force)
    except OSError as e:
        print(f"classic7-tray-fix: Recycle Bin icon not changed: {e}")
    do_tray = (force or not MARKER.exists()) and Path(f"/usr/share/plasma/plasmoids/{OURS}").is_dir()
    do_menu = (force or not MENU_MARKER.exists()) and MENU_SO.exists()
    if not (do_tray or do_menu):
        return 0
    if plasma_running() and not force:
        print("classic7-tray-fix: Plasma is running; the change is made at the next login")
        return 0
    try:
        text = APPLETSRC.read_text()
    except OSError:
        return 0                       # new account: the Classic 7 layout is created later
    new, changed = text, False
    if do_tray:
        new, c = fix(new)
        if c:
            print("classic7-tray-fix: removed Plasma's network icon from the system tray")
        changed |= c
    if do_menu:
        new, c = menu_fix(new)
        if c:
            print("classic7-tray-fix: the taskbar's right-click menu is now the Windows 7 one")
        changed |= c
    if changed:
        backup = APPLETSRC.with_name(APPLETSRC.name + ".before-tray-fix")
        if not backup.exists():
            shutil.copy2(APPLETSRC, backup)
        tmp = APPLETSRC.with_name(APPLETSRC.name + ".tmp")
        tmp.write_text(new)
        tmp.replace(APPLETSRC)
    for marker, done in ((MARKER, do_tray), (MENU_MARKER, do_menu)):
        if done:
            marker.parent.mkdir(parents=True, exist_ok=True)
            marker.write_text("1\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
