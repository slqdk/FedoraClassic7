[Desktop Entry]
Type=Service
MimeType=application/zip;application/x-zip-compressed;application/x-7z-compressed;application/vnd.rar;application/x-rar;application/x-rar-compressed;application/x-tar;application/x-compressed-tar;application/x-bzip2-compressed-tar;application/x-bzip-compressed-tar;application/x-xz-compressed-tar;application/x-zstd-compressed-tar;application/x-lzma-compressed-tar;application/x-lz4-compressed-tar;application/x-tarz;application/gzip;application/x-gzip;application/x-bzip2;application/x-bzip;application/x-xz;application/x-lzma;application/zstd;application/x-zstd;application/x-cpio;application/x-arj;application/arj;application/x-lha;application/x-lzh-compressed;application/vnd.ms-cab-compressed;application/x-cd-image;application/x-iso9660-image;application/x-archive;application/x-java-archive;application/x-rpm;application/x-deb;application/vnd.debian.binary-package;application/x-source-rpm;application/x-xar;application/x-squashfs-image;application/x-wim;application/x-msi;
X-KDE-Protocols=file
X-KDE-Submenu=7-Zip
X-KDE-Priority=TopLevel
X-KDE-StartupNotify=false
Icon=ark
Actions=open;extract;extracthere;extractfolder;

[Desktop Action open]
Name=Open archive
Icon=ark
Exec=ark %f

[Desktop Action extract]
Name=Extract files...
Icon=archive-extract
Exec=ark --batch --dialog %F

[Desktop Action extracthere]
Name=Extract Here
Icon=archive-extract
Exec=ark --batch --autodestination %F

[Desktop Action extractfolder]
Name=Extract to own folder
Icon=archive-extract
Exec=ark --batch --autodestination --autosubfolder %F
