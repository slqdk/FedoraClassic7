<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Classic 7</vendor>
  <!-- Disk Management: drive letters (entries in /etc/fstab), formatting and partitions.
       Like Windows' administrator prompt: an administrator's password, remembered for a few
       minutes. The helper refuses anything that holds the running system. -->
  <action id="org.classic7.disk">
    <description>Manage disks and drive letters</description>
    <message>Authentication is required to change disks and drive letters</message>
    <icon_name>drive-harddisk</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/classic7-disk-helper</annotate>
  </action>
</policyconfig>
