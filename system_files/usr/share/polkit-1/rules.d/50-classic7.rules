// Classic 7: administrators sitting at the computer may set the system keyboard layout
// without a password, so the login screen follows the layout chosen on the desktop
// (classic7-update does this at login), and may give the login screen the desktop's theme
// and screen settings (classic7-login-screen, run by classic7-appearance --login-screen).
polkit.addRule(function (action, subject) {
    if ((action.id == "org.freedesktop.locale1.set-keyboard" ||
         action.id == "org.classic7.loginscreen.change") &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
