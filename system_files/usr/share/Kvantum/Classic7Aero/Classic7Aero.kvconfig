[%General]
author=Classic7 project
comment=Windows 7 style controls for the Classic 7 Aero and Basic looks
x11drag=none
alt_mnemonic=true
left_tabs=true
attach_active_tab=true
embedded_tabs=false
mirror_doc_tabs=true
group_toolbar_buttons=false
spread_progressbar=false
composite=true
menu_shadow_depth=0
tooltip_shadow_depth=0
spread_menuitems=true
scroll_width=17
scroll_arrows=true
scroll_min_extent=24
transient_scrollbar=false
transient_groove=false
slider_width=4
slider_handle_width=11
slider_handle_length=21
center_toolbar_handle=true
check_size=13
textless_progressbar=false
progressbar_thickness=15
menubar_mouse_tracking=true
toolbutton_style=0
click_behavior=0
translucent_windows=false
blurring=false
popup_blurring=false
vertical_spin_indicators=true
fill_rubberband=false
merge_menubar_with_toolbar=false
small_icon_size=16
large_icon_size=32
button_icon_size=16
toolbar_icon_size=22
combo_as_lineedit=false
combo_menu=false
combo_focus_rect=false
inline_spin_indicators=false
remove_extra_frames=false
animate_states=true
no_inactiveness=false
menu_separator_height=7
layout_spacing=6
layout_margin=9
submenu_overlap=0
respect_DE=true

[GeneralColors]
window.color=#F0F0F0
base.color=#FFFFFF
alt.base.color=#F5F8FB
button.color=#F0F0F0
light.color=#FFFFFF
mid.light.color=#E3E3E3
dark.color=#A0A0A0
mid.color=#C8C8C8
highlight.color=#3399FF
inactive.highlight.color=#CCE4F7
text.color=#000000
window.text.color=#000000
button.text.color=#000000
disabled.text.color=#6D6D6D
tooltip.text.color=#575757
highlight.text.color=#FFFFFF
link.color=#0066CC
link.visited.color=#800080
progress.indicator.text.color=#000000

[Hacks]
transparent_ktitle_label=true
transparent_dolphin_view=false
respect_darkness=false
iconless_pushbutton=false
iconless_menu=false
transparent_arrow_button=true
no_selection_tint=true
force_size_grip=false

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
interior=true
interior.element=button
indicator.size=9
indicator.element=arrow
text.normal.color=#000000
text.focus.color=#000000
text.press.color=#000000
text.toggle.color=#000000
text.shadow=0
text.margin=1
text.iconspacing=4
text.margin.top=2
text.margin.bottom=2
text.margin.left=8
text.margin.right=8
frame.expansion=0
min_width=+0.3font

[PanelButtonTool]
inherits=PanelButtonCommand
frame.element=tbutton
interior.element=tbutton
text.margin.left=4
text.margin.right=4
min_width=0

[ToolbarButton]
inherits=PanelButtonTool

[Dock]
inherits=PanelButtonCommand
frame=false
interior=false

[DockTitle]
inherits=PanelButtonCommand
frame=false
interior=false
text.bold=false

[IndicatorSpinBox]
inherits=PanelButtonCommand
frame.element=spin
interior.element=spin
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
indicator.element=arrow
indicator.size=7

[RadioButton]
inherits=PanelButtonCommand
frame=false
interior.element=radio

[CheckBox]
inherits=PanelButtonCommand
frame=false
interior.element=checkbox

[Focus]
frame=true
frame.element=focus
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
frame.patternsize=0

[GenericFrame]
inherits=PanelButtonCommand
frame=true
interior=false
frame.element=common
interior.element=common
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1

[LineEdit]
inherits=PanelButtonCommand
frame.element=lineedit
interior.element=lineedit
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
text.margin.left=2
text.margin.right=2

[ToolbarLineEdit]
inherits=LineEdit

[DropDownButton]
inherits=PanelButtonCommand
indicator.element=arrow

[IndicatorArrow]
indicator.element=arrow
indicator.size=9

[ToolboxTab]
inherits=PanelButtonCommand

[Tab]
inherits=PanelButtonCommand
frame.element=tab
interior.element=tab
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
text.margin.left=8
text.margin.right=8
text.margin.top=2
text.margin.bottom=2
indicator.element=tab
indicator.size=12
focusFrame=false
min_width=+0.5font

[TabFrame]
inherits=PanelButtonCommand
frame.element=tabframe
interior.element=tabframe
interior=true
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3

[TabBarFrame]
inherits=GenericFrame
frame=false
interior=false

[TreeExpander]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.size=11
indicator.element=tree

[HeaderSection]
inherits=PanelButtonCommand
frame.element=header
interior.element=header
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
text.margin.left=6
text.margin.right=6
text.margin.top=2
text.margin.bottom=2

[SizeGrip]
indicator.element=resize-grip

[Toolbar]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=toolbar
indicator.size=5
text.margin=0

[Slider]
inherits=PanelButtonCommand
frame.element=slider
interior.element=slider
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2

[SliderCursor]
inherits=PanelButtonCommand
frame=false
interior.element=slidercursor

[Progressbar]
inherits=PanelButtonCommand
frame.element=progress
interior.element=progress
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
text.margin=0
text.bold=false

[ProgressbarContents]
inherits=PanelButtonCommand
frame=true
frame.element=progress-pattern
interior.element=progress-pattern
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2

[ItemView]
inherits=PanelButtonCommand
frame.element=itemview
interior.element=itemview
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
text.margin.top=0
text.margin.bottom=0
text.margin.left=3
text.margin.right=3
text.normal.color=#000000
text.focus.color=#000000
text.press.color=#000000
text.toggle.color=#000000

[Splitter]
indicator.size=32

[Scrollbar]
inherits=PanelButtonCommand
frame.element=sbutton
interior.element=sbutton
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
indicator.element=arrow
indicator.size=7

[ScrollbarSlider]
inherits=PanelButtonCommand
frame.element=scrollbarslider
interior.element=scrollbarslider
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
indicator.element=grip
indicator.size=8

[ScrollbarGroove]
inherits=PanelButtonCommand
frame=true
interior=true
frame.element=sgroove
interior.element=sgroove
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1

[MenuItem]
inherits=PanelButtonCommand
frame=true
frame.element=menuitem
interior.element=menuitem
indicator.element=arrow
text.normal.color=#000000
text.focus.color=#000000
text.press.color=#000000
text.toggle.color=#000000
text.margin.top=2
text.margin.bottom=2
text.margin.left=4
text.margin.right=4
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3

[MenuBar]
inherits=PanelButtonCommand
frame=true
frame.element=menubar
interior.element=menubar
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
text.normal.color=#000000

[MenuBarItem]
inherits=PanelButtonCommand
interior=true
frame.element=menubaritem
interior.element=menubaritem
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
text.margin.left=4
text.margin.right=4
text.margin.top=1
text.margin.bottom=1
text.normal.color=#000000
text.focus.color=#000000
text.press.color=#000000
text.toggle.color=#000000

[TitleBar]
inherits=PanelButtonCommand
frame=false
interior=false

[ComboBox]
inherits=PanelButtonCommand
indicator.element=arrow

[Menu]
inherits=PanelButtonCommand
frame.element=menu
interior.element=menu
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
text.normal.color=#000000

[GroupBox]
inherits=GenericFrame
frame=true
interior=false
frame.element=group
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
text.normal.color=#000000
text.bold=false

[ToolTip]
inherits=GenericFrame
frame.element=tooltip
interior.element=tooltip
interior=true
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
text.margin=1
text.normal.color=#575757

[StatusBar]
inherits=GenericFrame
frame=false
interior=false

[Window]
interior=false

[Dialog]
interior=false
